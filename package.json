{
  "name": "@vectorworks/draft-js",
  "description": "A React framework for building text editors.",
  "version": "0.12.0",
  "keywords": [
    "draftjs",
    "editor",
    "react",
    "richtext"
  ],
  "homepage": "http://draftjs.org/",
  "bugs": "https://github.com/Vectorworks/draft-js/issues",
  "files": [
    "dist/",
    "lib/",
    "LICENSE"
  ],
  "main": "lib/Draft.js",
  "style": "dist/Draft.css",
  "repository": "https://github.com/Vectorworks/draft-js.git",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "scripts": {
    "prepublish": "npm run build",
    "pretest": "node scripts/check-node-version.js",
    "build": "gulp",
    "dev": "gulp dev",
    "postbuild": "node node_modules/fbjs-scripts/node/check-lib-requires.js lib",
    "lint": "biome lint .",
    "lint-docs": "alex . && yarn format-docs:diff",
    "format": "biome format --write .",
    "format-docs": "prettier --config prettier.config.js --write \"docs/**/*.md\"",
    "format-docs:diff": "prettier --config prettier.config.js --list-different \"docs/**/*.md\"",
    "flow": "flow src",
    "test": "cross-env NODE_ENV=test jest",
    "test-ci": "yarn lint && yarn flow && yarn test"
  },
  "dependencies": {
    "fbjs": "^3.0.5",
    "immutable": "^5.1.5",
    "object-assign": "^4.1.1"
  },
  "peerDependencies": {
    "react": ">=0.14.0",
    "react-dom": ">=0.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.29.7",
    "@babel/plugin-transform-optional-catch-binding": "^7.29.7",
    "@babel/plugin-transform-optional-chaining": "^7.29.7",
    "@biomejs/biome": "2.5.12",
    "alex": "^9.1.1",
    "babel-preset-fbjs": "^3.4.0",
    "cross-env": "^7.0.3",
    "del": "^5.1.0",
    "es6-shim": "^0.35.8",
    "fancy-log": "^2.0.0",
    "fbjs-scripts": "^2.0.0",
    "flow-bin": "^0.130.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.1.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat-css": "^3.1.0",
    "gulp-derequire": "^3.0.0",
    "gulp-flatten": "^0.4.0",
    "gulp-header": "^2.0.12",
    "gulp-if": "^3.0.0",
    "gulp-rename": "^2.1.0",
    "jest": "^26.6.3",
    "plugin-error": "^2.0.1",
    "prettier": "1.19.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-test-renderer": "^16.14.0",
    "stats-webpack-plugin": "^0.7.0",
    "through2": "^4.0.2",
    "uglifyjs-webpack-plugin": "^2.2.0",
    "webpack-stream": "6.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "jest": {
    "globals": {
      "__DEV__": true
    },
    "rootDir": "./",
    "roots": [
      "<rootDir>/src/"
    ],
    "setupFiles": [
      "<rootDir>/scripts/jest/shims.js"
    ],
    "transform": {
      ".*": "<rootDir>/scripts/jest/preprocessor.js"
    },
    "haste": {
      "hasteImplModulePath": "<rootDir>/scripts/jest/hasteImpl.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/node_modules/"
    ],
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/"
    ],
    "unmockedModulePathPatterns": [
      "<rootDir>/node_modules/fbjs/node_modules/",
      "<rootDir>/node_modules/fbjs/lib/UserAgent.js",
      "<rootDir>/node_modules/fbjs/lib/UserAgentData.js",
      "<rootDir>/node_modules/fbjs-scripts/",
      "<rootDir>/node_modules/immutable/",
      "<rootDir>/node_modules/object-assign/",
      "<rootDir>/node_modules/react/",
      "<rootDir>/node_modules/react-dom/"
    ]
  }
}
